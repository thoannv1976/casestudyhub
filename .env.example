# ---------------------------------------------------------------------------
# CaseStudy Hub - environment variables
# Copy to .env.local for local development. Never commit a filled-in copy.
# ---------------------------------------------------------------------------

# --- Google Cloud / Firebase (server) --------------------------------------
GOOGLE_CLOUD_PROJECT=casestudy1-509414
FIREBASE_STORAGE_BUCKET=casestudy1-509414.firebasestorage.app

# Only for local development outside the emulator. On Cloud Run the runtime
# service account supplies credentials, so leave both unset there.
# GOOGLE_APPLICATION_CREDENTIALS=./secrets/service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Firebase Emulator Suite (local development and CI) --------------------
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# --- Firebase client SDK (public, baked into the browser bundle) -----------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=casestudy1-509414.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=casestudy1-509414
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=casestudy1-509414.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1089225172972
NEXT_PUBLIC_FIREBASE_APP_ID=
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

