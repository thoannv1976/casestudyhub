rules_version = '2';

// CaseStudy Hub - Cloud Storage security rules.
//
// No learning material, submission or assessment report is ever public.
// Clients read files through short-lived signed URLs issued by the server,
// which checks class membership first (SRS 20). Uploads go the same way, so
// direct client writes stay closed.

service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
